# NetClaw Convergence API (067-convergence) — see ui/convergence-api/README.md
# For dual-run, HUD may use NETWORK_GUARDIAN_* against the pilot instead of this process.

# Network Guardian Web — Environment Variables
# Copy to .env and fill in values

# Server
PORT=3000
NODE_ENV=development

# Backend API URLs (cluster-internal)
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
ALERTMANAGER_URL=http://alertmanager:9093

# Public URL (for PWA manifest, CORS, etc.)
PUBLIC_URL=https://guardian.byrnbaker.me

# Auth
JWT_SECRET=change-me-to-a-strong-random-string

# Users (JSON array — move to a proper store when scaling beyond a few users)
USERS='[{"id":"admin","username":"admin","passwordHash":"$2b$10$REPLACE_WITH_BCRYPT_HASH","role":"admin","sites":["home"],"name":"Admin"}]'

# Site configuration (JSON)
SITES_CONFIG='{"home":{"name":"Home Pilot","wanInterface":"igc0.201","deviceName":"pfsense","speedtestTarget":1000000000,"thresholds":{"latency":{"green":40,"yellow":80},"loss":{"green":0,"yellow":5},"txRetries":{"green":20,"yellow":35},"speedtest":{"green":900000000,"yellow":700000000}}}}'

# Source of Truth adapter (none | nautobot | netbox)
SOT_TYPE=none

# Nautobot credentials (required when SOT_TYPE=nautobot)
NAUTOBOT_URL=http://nautobot.nautobot.svc:8080
NAUTOBOT_TOKEN=

# NetBox credentials (required when SOT_TYPE=netbox — stub, not yet implemented)
# NETBOX_URL=
# NETBOX_TOKEN=
