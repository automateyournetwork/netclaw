  "dependencies": {
    "@daily-co/daily-js": "0.93.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "^3.4.16",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "gsap": "^3.12.5",
    "js-yaml": "^4.1.0",
    "lil-gui": "^0.19.2",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "three": "^0.185.1",
    "ws": "^8.16.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.1",
    "jsdom": "^30.1.1",
    "vite": "^6.4.3"
