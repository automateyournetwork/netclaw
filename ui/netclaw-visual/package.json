{
  "name": "netclaw-hud",
  "version": "1.0.0",
  "description": "NetClaw Three.js HUD — futuristic network operations dashboard",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server.js\" \"vite\"",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-unit-tests.mjs",
    "test:bundle": "npm run build && node scripts/check-canvas-bundle.mjs",
    "test:canvas": "node test/run-canvas.mjs",
    "test:terminal": "node test/terminal-smoke.mjs",
    "test:testbed": "node test/testbed-editor.mjs",
    "test:enrichment": "node test/terminal-enrichment.mjs",
    "test:enrichment-layout": "node test/enrichment-layout.mjs",
    "test:terminal-selection": "node test/terminal-mouse-coordinates.mjs",
    "test:topology": "node test/topology.mjs",
    "test:topology-facts": "node test/topology-facts.mjs",
    "test:topology-closest": "node test/topology-closest.mjs",
    "test:topology-api": "node test/topology-api.mjs",
    "test:ssh-policy": "node test/terminal-ssh-policy.mjs",
    "test:terminal-local": "node test/terminal-local-request.mjs",
    "test:terminal-credentials": "node test/terminal-credentials.mjs",
    "test:intent": "node test/terminal-intent.mjs",
    "test:intent-execution": "node test/terminal-intent-execution.mjs",
    "test:intent-live": "node test/terminal-intent-live.mjs",
    "test:intent-live-ui": "node test/terminal-intent-live-ui.mjs",
    "test:change-policy": "node test/terminal-change-policy.mjs",
