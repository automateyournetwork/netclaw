# Copy to secret.yml and fill in real values (NEVER commit secret.yml)
# Generate JWT_SECRET: openssl rand -base64 32
# Generate password hash: node -e "require('bcrypt').hash('YOUR_PASSWORD',10).then(h=>console.log(h))"
# Default password for the example below: guardian2026
apiVersion: v1
kind: Secret
metadata:
  name: network-guardian-web-secret
  namespace: observability
type: Opaque
stringData:
  JWT_SECRET: "<generate with: openssl rand -base64 32>"
  USERS: '[{"id":"admin","username":"admin","passwordHash":"$2b$10$GBclalwp99F69Uah8P1yQulAQcHJeWxVFek6PGJP.sMtm1VPaU8Qe","role":"admin","sites":["home"],"name":"Brian Baker"}]'
  API_KEYS: '[{"id":"netclaw","name":"NetClaw","key":"<generate with: openssl rand -hex 32>","role":"admin","sites":["home"]}]'
