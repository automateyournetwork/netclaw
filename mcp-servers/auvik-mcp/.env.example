# Auvik MCP Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env or real credentials to version control.

# ---------------------------------------------------------------------------
# Required: Auvik API credentials
# ---------------------------------------------------------------------------

# Your Auvik user email address (used as HTTP Basic-auth username)
AUVIK_USERNAME=

# Your Auvik API key (used as HTTP Basic-auth password)
# Generate at: Auvik portal → Admin → API keys
AUVIK_API_KEY=

# ---------------------------------------------------------------------------
# Optional: API connection settings
# ---------------------------------------------------------------------------

# Auvik regional cluster base URL.
# Swap "us1" for your region (e.g. us2, eu1, ca1, au1).
# See: https://support.auvik.com/hc/en-us/articles/360033373791
AUVIK_BASE_URL=https://auvikapi.us1.my.auvik.com

# Verify TLS certificates. Set to false only in isolated test environments.
AUVIK_VERIFY_SSL=true

# HTTP request timeout in seconds.
AUVIK_TIMEOUT=30

# ---------------------------------------------------------------------------
# Optional: Rate limiting and pagination
# ---------------------------------------------------------------------------

# Maximum API calls allowed per 60-second sliding window.
# Auvik does not publish an official rate limit; 600/min is a safe default.
AUVIK_RATE_LIMIT=600

# Maximum number of pages fetched during auto-pagination.
# Increase if you regularly hit "truncated: true" on large tenants.
AUVIK_MAX_PAGES=50
