# Halo (HaloPSA / HaloITSM / HaloCRM) MCP Server (Feature 069)
# 18 tools: open change requests (1 gated write) + read assets, tickets, and
# context (clients/sites/users/contracts) + ticket types/fields + KB.
#
# Auth: OAuth2 client-credentials. Create an API application in Halo:
#   Configuration > Integrations > Halo API > New  (Client Credentials)
# Grant it the minimum permissions needed (read tickets/assets + create tickets).

HALO_BASE_URL=https://your-tenant.halopsa.com   # Halo host, no trailing /api
HALO_TENANT=your-tenant                         # hosted multi-tenant id (blank for single-tenant)
HALO_CLIENT_ID=your-client-id                   # API application client id
HALO_CLIENT_SECRET=your-client-secret           # API application secret
HALO_SCOPE=all                                  # OAuth scope (default: all)

# --- optional tuning (safe defaults shown) ---
# HALO_AUTH_URL=                                # override token URL for self-hosted layouts
# HALO_VERIFY_SSL=true                          # verify TLS certificates
# HALO_TIMEOUT=30                               # per-request timeout (seconds)
# HALO_PAGE_SIZE=50                             # list page size (server cap 100)
# HALO_MAX_PAGES=20                             # max pages fetched per list call
# HALO_RATE_LIMIT=0                             # proactive calls/min limiter (0 = off; 429 backoff always on)
