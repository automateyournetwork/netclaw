{
  "enabled": true,
  "name": "Sync Testbed from Nautobot",
  "description": "Regenerates the pyATS testbed.yaml from Nautobot device inventory before each task execution, ensuring pyATS always uses Nautobot as the source of truth for device connectivity.",
  "version": "1",
  "when": {
    "type": "preTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "/home/ubuntu/netclaw/.venv/bin/python3 /home/ubuntu/netclaw/scripts/generate-testbed-from-nautobot.py",
    "timeout": 30
  }
}