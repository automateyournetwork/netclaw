<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  099/FR-008 (Story 3). Export options for `xcodebuild -exportArchive`,
  consumed by scripts/mobile-release-archive.sh.

  teamID below is a PLACEHOLDER -- fill in the real paid Apple Developer
  Program team ID (found at developer.apple.com/account under Membership)
  once that account exists. Until then this file is inert: nothing in this
  feature's CI or build path invokes -exportArchive automatically (see
  docs/MOBILE-RELEASE.md).
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store</string>
	<key>teamID</key>
	<string>REPLACE_WITH_PAID_TEAM_ID</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
