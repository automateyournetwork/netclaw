  <!-- Pre-existing latent bug fix, unrelated to spec 099's own stories:
       without this key Flutter's generated FlutterGeneratedPluginSwiftPackage/
       Package.swift hardcodes a platform floor of iOS 13.0 regardless of
       Runner's actual IPHONEOS_DEPLOYMENT_TARGET, which conflicts with
       firebase_core/firebase_messaging's real minimum of iOS 15 -- Xcode only
       enforces this on a fully fresh package-graph resolution (a persisted
       DerivedData/SPM cache can mask it), which is exactly what CI always
       does, so this would have broken the mobile-ci.yml gate (099 Story 4)
       on its very first run regardless of anything else in this feature.
       Matches Runner's actual floor (099/research.md R2). -->
  <key>MinimumOSVersion</key>
  <string>16.2</string>
</dict>
</plist>
