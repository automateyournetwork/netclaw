{
  "uid": "bgp-route-stability",
  "title": "BGP Route Stability & Path Quality",
  "description": "Monitors BGP route announcements/withdrawals, flap damping penalties, interface status correlation, and IP SLA jitter/loss metrics",
  "tags": ["bgp", "routing", "stability", "netclaw"],
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(interface_status, device_name)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "BGP Route Events",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Route Withdrawals Rate",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "rate(bgp_route_withdrawals_total[5m])", "legendFormat": "{{prefix}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "area" } }
        }
      }
    },
    {
      "id": 3,
      "title": "Route Announcements Rate",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "rate(bgp_route_announcements_total[5m])", "legendFormat": "{{prefix}}" }
      ]
    },
    {
      "id": 10,
      "title": "Flap Damping & RIB",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "Flap Damping Penalty",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "bgp_route_flap_penalty", "legendFormat": "{{prefix}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 3000,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 750 },
              { "color": "orange", "value": 2000 },
              { "color": "red", "value": 3000 }
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "title": "Suppressed Routes",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 8, "y": 9 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "sum(bgp_route_suppressed) or vector(0)", "legendFormat": "Suppressed" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "title": "RIB Size",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 12, "y": 9 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "bgp_rib_size", "legendFormat": "Routes" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 14,
      "title": "BGP Peer State",
      "type": "table",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "bgp_peer_state", "legendFormat": "{{peer}}", "format": "table", "instant": true }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "mappings", "value": [{ "type": "value", "options": { "1": { "text": "Established", "color": "green" }, "0": { "text": "Down", "color": "red" } } }] }
            ]
          }
        ]
      }
    },
    {
      "id": 20,
      "title": "Physical Layer Correlation",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Interface Flaps (status transitions in 5m)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "changes(interface_status{device_name=~\"$device\"}[5m]) > 0", "legendFormat": "{{device_name}} {{interface}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line+area" } }
        }
      }
    },
    {
      "id": 22,
      "title": "Interface Error Rate (correlated)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "rate(interface_errors_in_total{device_name=~\"$device\"}[5m]) > 0", "legendFormat": "{{device_name}} {{interface}} IN" },
        { "expr": "rate(interface_errors_out_total{device_name=~\"$device\"}[5m]) > 0", "legendFormat": "{{device_name}} {{interface}} OUT" }
      ],
      "fieldConfig": { "defaults": { "unit": "err/s" } }
    },
    {
      "id": 30,
      "title": "Path Quality (IP SLA)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false
    },
    {
      "id": 31,
      "title": "IP SLA Jitter (avg ms)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 25 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "ip_sla_jitter_avg{device_name=~\"$device\"}", "legendFormat": "{{device_name}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        }
      }
    },
    {
      "id": 32,
      "title": "IP SLA Packet Loss",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 25 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "rate(ip_sla_packet_loss_sd_total{device_name=~\"$device\"}[5m])", "legendFormat": "{{device_name}} S→D" },
        { "expr": "rate(ip_sla_packet_loss_ds_total{device_name=~\"$device\"}[5m])", "legendFormat": "{{device_name}} D→S" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      }
    },
    {
      "id": 33,
      "title": "IP SLA Round-Trip Time",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 25 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "ip_sla_rtt{device_name=~\"$device\"}", "legendFormat": "{{device_name}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      }
    },
    {
      "id": 40,
      "title": "Syslog Correlation",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false
    },
    {
      "id": 41,
      "title": "BGP/Interface Syslog Events",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "datasource": "Loki",
      "targets": [
        { "expr": "{service_name=\"network-devices\"} |~ \"(?i)(BGP|LINEPROTO|UPDOWN|ADJCHANGE|OSPF)\" | line_format \"{{.device_name}}: {{.body}}\"", "refId": "A" }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "enableLogDetails": true }
    }
  ],
  "schemaVersion": 39
}
