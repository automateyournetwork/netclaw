{
  "uid": "bgp-route-stability",
  "title": "BGP Route Stability & Path Quality",
  "description": "Router-native BGP observability (netclaw_* metrics via SNMP/gNMI/BMP). Protocol MCP panels deprecated.",
  "tags": ["bgp", "routing", "stability", "netclaw"],
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": "label_values(netclaw_path_jitter_ms, device_name)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "BGP Route Events",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Peer In UPDATEs (SNMP, 5m)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "round(increase(netclaw_bgp_peer_in_updates_total{device_name=~\"$device\",job=\"netclaw-bgp-snmp\"}[5m]))", "legendFormat": "{{device_name}} {{neighbor}} in" }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "area" } }
        }
      },
      "description": "All BGP UPDATE messages received per peer (SNMP bgpPeerInUpdates). Not the same as route withdrawals — one line per neighbor session."
    },
    {
      "id": 3,
      "title": "Peer Out UPDATEs (SNMP, 5m)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "round(increase(netclaw_bgp_peer_out_updates_total{device_name=~\"$device\",job=\"netclaw-bgp-snmp\"}[5m]))", "legendFormat": "{{device_name}} {{neighbor}} out" }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short"
        }
      },
      "description": "All BGP UPDATE messages sent per peer (SNMP bgpPeerOutUpdates). Not per-prefix announcements."
    },
    {
      "id": 6,
      "title": "BMP Prefix Withdrawals (5m)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "round(increase(netclaw_bgp_prefix_withdrawals_total{device_name=~\"$device\",job=\"netclaw-bgp-bmp\"}[5m]))", "legendFormat": "{{device_name}} {{prefix}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "area" } }
        }
      },
      "description": "Per-prefix route withdrawals from BMP route monitor (DEL). Requires BMP peer (e.g. RR1 → gobmp :5000)."
    },
    {
      "id": 7,
      "title": "BMP Prefix Announcements (5m)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "round(increase(netclaw_bgp_prefix_announcements_total{device_name=~\"$device\",job=\"netclaw-bgp-bmp\"}[5m]))", "legendFormat": "{{device_name}} {{prefix}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short"
        }
      },
      "description": "Per-prefix route announcements from BMP route monitor (ADD/UPDATE)."
    },
    {
      "id": 4,
      "title": "BMP Pipeline",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "netclaw_bmp_consumer_up or vector(0)", "legendFormat": "Consumer" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Ready", "color": "green" } } }
          ],
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "description": "1 = Kafka consumer subscribed; prefix metrics appear when BMP peers connect."
    },
    {
      "id": 5,
      "title": "BMP RIB Routes",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "sum(netclaw_bgp_rib_routes_total{device_name=~\"$device\",source=\"bmp\"}) or vector(0)", "legendFormat": "RIB" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "description": "From BMP statistics reports; empty in lab without BMP peers."
    },
    {
      "id": 10,
      "title": "Flap Damping & RIB",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "Flap Damping Penalty",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "increase(netclaw_bgp_peer_established_transitions_total{device_name=~\"$device\",job=\"netclaw-bgp-snmp\"}[1h])", "legendFormat": "{{device_name}} {{neighbor}} session flaps" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 3000,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 750 },
              { "color": "orange", "value": 2000 },
              { "color": "red", "value": 3000 }
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "title": "Established Peers",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 8, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "count(netclaw_bgp_peer_state{device_name=~\"$device\",job=\"netclaw-bgp-snmp\"} == 6) or vector(0)", "legendFormat": "Established" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "title": "Prefixes Received (sum)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "sum(netclaw_bgp_peer_prefixes_received{device_name=~\"$device\",job=\"netclaw-bgp-snmp\"}) or vector(0)", "legendFormat": "Prefixes" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 14,
      "title": "BGP Peer State",
      "type": "table",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "netclaw_bgp_peer_state{device_name=~\"$device\",job=\"netclaw-bgp-snmp\"}", "legendFormat": "{{device_name}} {{neighbor}}", "format": "table", "instant": true }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "mappings", "value": [{ "type": "value", "options": { "6": { "text": "Established", "color": "green" }, "1": { "text": "Idle", "color": "yellow" }, "3": { "text": "Active", "color": "orange" } } }] }
            ]
          }
        ]
      }
    },
    {
      "id": 20,
      "title": "Physical Layer Correlation",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Interface Flaps (status transitions in 5m)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "changes(interface_status{device_name=~\"$device\"}[5m]) > 0", "legendFormat": "{{device_name}} {{interface}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line+area" } }
        }
      }
    },
    {
      "id": 22,
      "title": "Interface Error Rate (correlated)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "rate(interface_errors_in_total{device_name=~\"$device\"}[5m]) > 0", "legendFormat": "{{device_name}} {{interface}} IN" },
        { "expr": "rate(interface_errors_out_total{device_name=~\"$device\"}[5m]) > 0", "legendFormat": "{{device_name}} {{interface}} OUT" }
      ],
      "fieldConfig": { "defaults": { "unit": "err/s" } }
    },
    {
      "id": 30,
      "title": "Path Quality (IP SLA)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "collapsed": false
    },
    {
      "id": 31,
      "title": "IP SLA Jitter (avg ms)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "netclaw_path_jitter_ms{device_name=~\"$device\"}", "legendFormat": "{{device_name}} probe {{probe_id}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        }
      }
    },
    {
      "id": 32,
      "title": "IP SLA Packet Loss",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "netclaw_path_loss_packets{device_name=~\"$device\"}", "legendFormat": "{{device_name}} probe {{probe_id}} loss" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      }
    },
    {
      "id": 33,
      "title": "IP SLA Round-Trip Time",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "netclaw_path_rtt_ms{device_name=~\"$device\"}", "legendFormat": "{{device_name}} probe {{probe_id}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      }
    },
    {
      "id": 40,
      "title": "Syslog Correlation",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "collapsed": false
    },
    {
      "id": 41,
      "title": "BGP/Interface Syslog Events",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "datasource": "Loki",
      "targets": [
        { "expr": "{service_name=\"network-devices\", device_name=~\"$device\"} |~ \"(?i)(BGP|LINEPROTO|UPDOWN|ADJCHANGE)\"", "refId": "A" }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "enableLogDetails": true }
    }
  ],
  "schemaVersion": 39
}
