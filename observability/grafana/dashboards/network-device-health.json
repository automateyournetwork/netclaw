{
  "uid": "netclaw-device-health",
  "title": "Network Device Health",
  "tags": ["netclaw", "network", "health"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(interface_status, device_name)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "vendor",
        "type": "query",
        "datasource": "VictoriaMetrics",
        "query": "label_values(interface_status, device_vendor)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Fleet Summary",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Total Devices",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": "VictoriaMetrics",
      "targets": [{ "expr": "count(count(interface_status{device_name=~\"$device\", device_vendor=~\"$vendor\"}) by (device_name))" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 3,
      "title": "Interfaces Up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": "VictoriaMetrics",
      "targets": [{ "expr": "count(interface_status{device_name=~\"$device\", device_vendor=~\"$vendor\"} == 1)" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } }
    },
    {
      "id": 4,
      "title": "Interfaces Down",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": "VictoriaMetrics",
      "targets": [{ "expr": "count(interface_status{device_name=~\"$device\", device_vendor=~\"$vendor\"} == 2)" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Total Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": "VictoriaMetrics",
      "targets": [{ "expr": "sum(rate(interface_errors_in_total{device_name=~\"$device\"}[5m])) + sum(rate(interface_errors_out_total{device_name=~\"$device\"}[5m]))", "legendFormat": "err/s" }],
      "fieldConfig": {
        "defaults": {
          "unit": "err/s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Total Throughput (In)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": "VictoriaMetrics",
      "targets": [{ "expr": "sum(rate(interface_octets_in_bytes_total{device_name=~\"$device\"}[5m])) * 8" }],
      "fieldConfig": { "defaults": { "unit": "bps" } }
    },
    {
      "id": 7,
      "title": "Total Throughput (Out)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": "VictoriaMetrics",
      "targets": [{ "expr": "sum(rate(interface_octets_out_bytes_total{device_name=~\"$device\"}[5m])) * 8" }],
      "fieldConfig": { "defaults": { "unit": "bps" } }
    },
    {
      "id": 10,
      "title": "Interface Status per Device",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "Interfaces Up per Device",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "count(interface_status{device_name=~\"$device\", device_vendor=~\"$vendor\"} == 1) by (device_name)", "legendFormat": "{{device_name}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient" }
    },
    {
      "id": 12,
      "title": "Interface Flaps (status changes in 10m)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "changes(interface_status{device_name=~\"$device\"}[10m]) > 0", "format": "table", "instant": true }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "service_name": true, "device_ip": true },
            "renameByName": { "device_name": "Device", "device_vendor": "Vendor", "interface": "Interface", "Value": "Flaps (10m)" }
          }
        }
      ]
    },
    {
      "id": 20,
      "title": "Traffic & Errors",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Traffic per Device (bits/s in)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "sum(rate(interface_octets_in_bytes_total{device_name=~\"$device\", device_vendor=~\"$vendor\"}[5m])) by (device_name) * 8", "legendFormat": "{{device_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "fillOpacity": 10 } } }
    },
    {
      "id": 22,
      "title": "Traffic per Device (bits/s out)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "sum(rate(interface_octets_out_bytes_total{device_name=~\"$device\", device_vendor=~\"$vendor\"}[5m])) by (device_name) * 8", "legendFormat": "{{device_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bps", "custom": { "fillOpacity": 10 } } }
    },
    {
      "id": 23,
      "title": "Interface Errors (rate/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "rate(interface_errors_in_total{device_name=~\"$device\"}[5m]) > 0", "legendFormat": "{{device_name}} {{interface}} IN" },
        { "expr": "rate(interface_errors_out_total{device_name=~\"$device\"}[5m]) > 0", "legendFormat": "{{device_name}} {{interface}} OUT" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "err/s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 24,
      "title": "Top Talkers (highest traffic interfaces)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": "VictoriaMetrics",
      "targets": [
        { "expr": "topk(10, rate(interface_octets_in_bytes_total{device_name=~\"$device\"}[5m]) * 8)", "legendFormat": "{{device_name}} {{interface}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bps" } }
    },
    {
      "id": 30,
      "title": "Syslog Events",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false
    },
    {
      "id": 31,
      "title": "Recent Syslog (last 30m)",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": "Loki",
      "targets": [
        { "expr": "{service_name=\"network-devices\"}", "refId": "A" }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "enableLogDetails": true }
    }
  ],
  "schemaVersion": 39
}
