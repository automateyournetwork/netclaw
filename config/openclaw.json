{
  "gateway": {
    "mode": "local"
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": {
        "primary": "ollama/qwen3.5:397b-cloud",
        "fallbacks": [
          "ollama/qwen3.5:cloud"
        ]
      },
      "params": {
        "cacheRetention": "long"
      }
    }
  },
  "tokenOptimization": {
    "enabled": true,
    "libraryPath": "src/netclaw_tokens",
    "toonSerializationDefault": true,
    "footerDisplay": "always",
    "sessionTracking": true,
    "pricingOverrideEnvVar": "NETCLAW_TOKEN_PRICING_OVERRIDE"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "mcpServers": {
    "pyats-mcp": {
      "command": "/opt/venv/bin/python3",
      "args": [
        "-u",
        "/opt/netclaw/mcp-servers/pyATS_MCP/pyats_mcp_server.py"
      ],
      "env": {
        "PYATS_TESTBED_PATH": "${PYATS_TESTBED_PATH:-/root/.openclaw/workspace/testbed/testbed.yaml}"
      }
    },
    "gait-mcp": {
      "command": "/opt/venv/bin/python3",
      "args": [
        "-u",
        "/opt/netclaw/scripts/gait-stdio.py"
      ]
    },
    "markmap-mcp": {
      "command": "node",
      "args": [
        "/opt/netclaw/mcp-servers/markmap_mcp/markmap-mcp/dist/index.js"
      ]
    },
    "nautobot-mcp": {
      "command": "/opt/venv/bin/python3",
      "args": [
        "-u",
        "/opt/netclaw/mcp-servers/nautobot-mcp-v2/server.py"
      ],
      "env": {
        "NAUTOBOT_URL": "${NAUTOBOT_URL}",
        "NAUTOBOT_TOKEN": "${NAUTOBOT_TOKEN}",
        "NAUTOBOT_VERIFY_SSL": "${NAUTOBOT_VERIFY_SSL:-false}",
        "NAUTOBOT_TIMEOUT": "${NAUTOBOT_TIMEOUT:-30}",
        "ITSM_ENABLED": "${ITSM_ENABLED:-false}",
        "ITSM_LAB_MODE": "${ITSM_LAB_MODE:-true}"
      }
    },
    "wikipedia-mcp": {
      "command": "/opt/venv/bin/python3",
      "args": [
        "-u",
        "/opt/netclaw/mcp-servers/Wikipedia_MCP/main.py"
      ]
    },
    "subnet-calculator-mcp": {
      "command": "/opt/venv/bin/python3",
      "args": [
        "-u",
        "/opt/netclaw/mcp-servers/subnet-calculator-mcp/servers/subnetcalculator_mcp.py"
      ]
    },
    "nmap-mcp": {
      "command": "/opt/venv/bin/python3",
      "args": [
        "-u",
        "/opt/netclaw/mcp-servers/nmap-mcp/server.py"
      ]
    },
    "mempalace-mcp": {
      "command": "/opt/venv/bin/python3",
      "args": [
        "-u",
        "-m",
        "mempalace.mcp_server"
      ]
    },
    "drawio-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@drawio/mcp"
      ]
    },
    "rfc-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@mjpitz/mcp-rfc"
      ]
    },
    "github-mcp": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "proxmox-mcp": {
      "command": "node",
      "args": [
        "/home/ubuntu/netclaw/mcp-servers/mcp-proxmox/index.js"
      ],
      "env": {
        "PROXMOX_HOST": "${PROXMOX_HOST}",
        "PROXMOX_PORT": "${PROXMOX_PORT:-8006}",
        "PROXMOX_USER": "${PROXMOX_USER:-root@pam}",
        "PROXMOX_TOKEN_NAME": "${PROXMOX_TOKEN_NAME:-mcpserver}",
        "PROXMOX_TOKEN_VALUE": "${PROXMOX_TOKEN_VALUE}",
        "PROXMOX_ALLOW_ELEVATED": "${PROXMOX_ALLOW_ELEVATED:-false}"
      }
    }
  }
}