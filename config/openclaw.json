{
  "gateway": {
    "mode": "local"
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": {
        "primary": "anthropic/claude-opus-4-6",
        "fallbacks": [
          "anthropic/claude-sonnet-4-6"
        ]
      }
    }
  },
  "tokenOptimization": {
    "enabled": true,
    "libraryPath": "src/netclaw_tokens",
    "gcfSerializationDefault": true,
    "footerDisplay": "always",
    "sessionTracking": true,
    "pricingOverrideEnvVar": "NETCLAW_TOKEN_PRICING_OVERRIDE"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "security": {
    "mode": "hobby"
  },
  "mcpServers": {
    "forward-official-mcp": {
      "url": "${FORWARD_URL}/api/mcp",
      "headers": {
        "Authorization": "Basic ${FORWARD_AUTH_BASE64}"
      },
      "env": {
        "FORWARD_URL": "${FORWARD_URL}",
        "FORWARD_AUTH_BASE64": "${FORWARD_AUTH_BASE64}"
      }
    },
    "suzieq-mcp": {
      "command": "python3",
      "args": [
        "-u",
        "mcp-servers/suzieq-mcp/server.py"
      ],
      "env": {
        "SUZIEQ_API_URL": "${SUZIEQ_API_URL}",
        "SUZIEQ_API_KEY": "${SUZIEQ_API_KEY}",
        "SUZIEQ_VERIFY_SSL": "${SUZIEQ_VERIFY_SSL}",
        "SUZIEQ_TIMEOUT": "${SUZIEQ_TIMEOUT}"
      }
    },
    "zoom-rtms-mcp": {
      "command": "mcp-servers/zoom-rtms-mcp/.venv/bin/python",
      "args": [
        "-u",
        "mcp-servers/zoom-rtms-mcp/server.py"
      ],
      "env": {
        "ZOOM_CLIENT_ID": "${ZOOM_CLIENT_ID}",
        "ZOOM_CLIENT_SECRET": "${ZOOM_CLIENT_SECRET}",
        "ZOOM_ACCOUNT_ID": "${ZOOM_ACCOUNT_ID}",
        "ZOOM_RTMS_WEBHOOK_SECRET": "${ZOOM_RTMS_WEBHOOK_SECRET}",
        "ZOOM_RTMS_WEBHOOK_PORT": "${ZOOM_RTMS_WEBHOOK_PORT}",
        "ZOOM_PANEL_FEED_PORT": "${ZOOM_PANEL_FEED_PORT}",
        "N2N_ZOOM_CHANNEL_HOST": "${N2N_ZOOM_CHANNEL_HOST}",
        "N2N_ZOOM_CHANNEL_PORT": "${N2N_ZOOM_CHANNEL_PORT}",
        "N2N_ZOOM_CHANNEL_SECRET": "${N2N_ZOOM_CHANNEL_SECRET}"
      }
    },
    "batfish-mcp": {
      "command": "python3",
      "args": [
        "-u",
        "mcp-servers/batfish-mcp/batfish_mcp_server.py"
      ],
      "env": {
        "BATFISH_HOST": "${BATFISH_HOST}",
        "BATFISH_PORT": "${BATFISH_PORT}",
        "BATFISH_NETWORK": "${BATFISH_NETWORK}"
      }
    },
    "gnmi-mcp": {
      "command": "python3",
      "args": [
        "-u",
        "mcp-servers/gnmi-mcp/gnmi_mcp_server.py"
      ],
      "env": {
        "GNMI_TARGETS": "${GNMI_TARGETS}",
        "GNMI_TLS_CA_CERT": "${GNMI_TLS_CA_CERT}",
        "GNMI_TLS_CLIENT_CERT": "${GNMI_TLS_CLIENT_CERT}",
        "GNMI_TLS_CLIENT_KEY": "${GNMI_TLS_CLIENT_KEY}",
        "GNMI_TLS_SKIP_VERIFY": "${GNMI_TLS_SKIP_VERIFY}",
        "GNMI_DEFAULT_PORT": "${GNMI_DEFAULT_PORT}",
        "GNMI_MAX_RESPONSE_SIZE": "${GNMI_MAX_RESPONSE_SIZE}",
        "GNMI_MAX_SUBSCRIPTIONS": "${GNMI_MAX_SUBSCRIPTIONS}",
