  "command_remedies": {
    "uv": "install uv and put uv/uvx on PATH (macOS: brew install uv)",
    "uvx": "install uv and put uv/uvx on PATH (macOS: brew install uv)",
    "docker": "install Docker and start its daemon before retrying",
    "kubectl": "install kubectl; the integration also needs a configured Kubernetes cluster",
    "ollama": "install Ollama; models and its service require separate setup",
    "tshark": "install Wireshark CLI tools (macOS: brew install wireshark)",
    "capinfos": "install Wireshark CLI tools; packet summaries otherwise use fallback mode",
    "nmap": "install nmap (macOS: brew install nmap)",
    "dot": "install Graphviz for AWS diagrams (macOS: brew install graphviz)"
  }
