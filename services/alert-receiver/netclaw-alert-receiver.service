# Systemd service for the NetClaw Alert Receiver.
# Install:
#   sudo cp netclaw-alert-receiver.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now netclaw-alert-receiver

[Unit]
Description=NetClaw Alert Receiver (Alertmanager webhook → NetClaw)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/netclaw/services/alert-receiver
ExecStart=/home/ubuntu/netclaw/.venv/bin/python server.py
Restart=on-failure
RestartSec=5
Environment=PATH=/home/ubuntu/netclaw/.venv/bin:/usr/bin:/bin
Environment=HOME=/home/ubuntu

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
# alert-receiver runtime dir + the OpenClaw skills dir the selector scopes.
# (The canonical catalog under /home/ubuntu/netclaw is only read, which is
# allowed under ProtectSystem=strict.)
ReadWritePaths=/home/ubuntu/netclaw/services/alert-receiver /home/ubuntu/.openclaw/workspace/skills

[Install]
WantedBy=multi-user.target
