[Unit]
# DefenseClaw guardrail sidecar — the model-guard proxy (feature 057).
# Checked-in TEMPLATE; `scripts/in2n-services.py generate` fills in the gateway, Python and
# helper paths and installs it to ~/.config/systemd/user/defenseclaw-sidecar.service.
# Started with `defenseclaw-gateway start` (spec 177): DefenseClaw then writes its own
# PID record, which its CLI needs (`defenseclaw skill enable`, audit recording, status).
# A foreground gateway never writes it. The helper hands systemd the gateway's PID, and
# Restart=always keeps production posture `enforced` across a crash or reboot.
# Prereq: `defenseclaw setup guardrail` has patched OpenClaw to route model I/O
# through the proxy (:4000).
Description=DefenseClaw guardrail sidecar (LLM proxy :4000 + tool policy) — feature 057 model-guard
After=network-online.target openclaw-gateway.service
Wants=openclaw-gateway.service

[Service]
Type=forking
Environment=PATH=@DGDIR@:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RuntimeDirectory=defenseclaw-sidecar
PIDFile=%t/defenseclaw-sidecar/gateway.pid
# Take over a gateway started by hand, so this unit supervises the one that runs.
ExecStartPre=-"@DG@" stop
ExecStart="@PY@" "@HELPER@" "@DG@"
ExecStop="@DG@" stop
TimeoutStartSec=180
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
