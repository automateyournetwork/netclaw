# Alert Receiver Configuration
ALERT_RECEIVER_HOST=0.0.0.0
ALERT_RECEIVER_PORT=8099

# Nautobot SoT lookup (optional — falls back to local inventory)
NAUTOBOT_URL=http://localhost:8080
NAUTOBOT_TOKEN=your_token_here

# OpenClaw gateway (to trigger NetClaw investigation)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_HOOK_TOKEN=your_hook_token_here

# Discord notification (optional) — immediate "alert received" notice
DISCORD_WEBHOOK_URL=
# Discord channel id for triage FINDINGS, posted by the agent via the native
# `openclaw message send` bridge after investigation. Leave blank to disable.
DISCORD_ALERT_CHANNEL_ID=

# Network Guardian dashboard — curated event diary for investigation outcomes.
# When configured, the receiver POSTs events to the Guardian API so customers
# and operators see investigation results in the dashboard.
# URL: https://network-guardian.localedgedatacenter.com (or internal ClusterIP)
# Token: static API key from Guardian k8s/secret.yml (never expires)
NETWORK_GUARDIAN_URL=https://network-guardian.localedgedatacenter.com
NETWORK_GUARDIAN_TOKEN=

# ── Nautobot intent-reconcile (webhook → propose → Discord approval → apply) ──
# Off by default. Scope: device interface changes on switches only; firewalls
# never; nothing applies without an explicit Discord `approve <id>`.
RECONCILE_ENABLED=false
# HMAC-SHA512 secret; must match the "Secret" on the Nautobot webhook. Required.
NAUTOBOT_WEBHOOK_SECRET=
RECONCILE_ALLOWED_MODELS=interface           # comma-separated Nautobot models
RECONCILE_ALLOWED_ROLES=switch               # allowed device roles (substring match)
RECONCILE_CHANNEL_ID=                         # Discord channel for proposals/approvals

# Log level
LOG_LEVEL=INFO

# ── Skill Scoping (optional — see docs/architecture/skill-context-scoping.md) ──
# Scope the runtime skills directory to the alert-relevant subset before
# triggering investigation, shrinking the injected skill index (~65-94% per
# turn). Disabled by default; behavior is unchanged unless enabled.
SKILL_SCOPING_ENABLED=false
# Interpreter used to run the selector (defaults to the receiver's python).
# Point at the repo venv if the selector needs pyyaml / sentence-transformers.
# SKILL_SELECTOR_PYTHON=/home/ubuntu/netclaw/.venv/bin/python
# SKILL_SELECTOR_SCRIPT=/home/ubuntu/netclaw/scripts/skill-selector/select_skills.py
# Canonical full catalog (source) and runtime dir OpenClaw scans (target).
# SKILL_CATALOG_DIR=/home/ubuntu/netclaw/workspace/skills
# SKILL_TARGET_DIR=/home/ubuntu/.openclaw/workspace/skills
# Skills always kept regardless of the alert (safety + device investigation).
# SKILL_SELECTOR_PINS=alert-triage,gait-session-tracking,memory-management,humanrail-escalation,pyats-network,pyats-troubleshoot
# Top-k relevant skills to select (in addition to pins).
# SKILL_SELECTOR_K=8
# Ranker: keyword (fast, no deps) | embeddings (semantic, needs sentence-transformers) | auto
# SKILL_SELECTOR_RANKER=keyword
# Max seconds to wait for the selector before proceeding with the full catalog.
# SKILL_SELECTOR_TIMEOUT=60
# After triggering, restore the full catalog so interactive sessions keep all
# skills. The fresh alert session reads skills at session start; we wait first.
# SKILL_RESTORE_AFTER_TRIGGER=true
# Seconds to wait after triggering before restoring the full catalog.
# SKILL_RESTORE_DELAY=8
