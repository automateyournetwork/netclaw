    {
      "title": "Error Rate (5m buckets)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({device_name=\"netclaw\"} |~ \"(?i)ERROR\"[5m]))",
