{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Federation Events (BGP/N2N)",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{device_name=\"netclaw\"} |~ \"(?i)(ESTABLISHED|Idle|NCFED|possession|channel|endpoint_update|iN2N|N2N|federation|BGP|peer)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "title": "Federation Event Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({device_name=\"netclaw\"} |~ \"ESTABLISHED|Idle\"[5m]))",
          "legendFormat": "BGP state changes",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({device_name=\"netclaw\"} |~ \"NCFED|federation\"[5m]))",
          "legendFormat": "Federation events",
          "refId": "B"
        },
        {
          "expr": "sum(count_over_time({device_name=\"netclaw\"} |~ \"possession|cert\"[5m]))",
          "legendFormat": "Cert/auth events",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        }
      }
    },
    {
      "title": "Alert Triage Activity",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({device_name=\"netclaw\"} |~ \"Triggered|triggered\"[5m]))",
          "legendFormat": "Triggered",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({device_name=\"netclaw\"} |~ \"scoped|Scoped\"[5m]))",
          "legendFormat": "Scoped",
          "refId": "B"
        },
        {
          "expr": "sum(count_over_time({device_name=\"netclaw\"} |~ \"Restored|resolved\"[5m]))",
          "legendFormat": "Restored",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        }
      }
    },
