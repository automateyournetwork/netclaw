{
  "uid": "network-interfaces",
  "title": "Network Interfaces",
  "description": "SNMP interface counters from switches and firewall (VictoriaMetrics long-term storage)\n\nUniFi AP SNMP targets (Basement 192.168.3.15, Sophie 192.168.3.16) use the same interface_* metrics with device_name labels. Filter device_name for \"U6-Pro\" once SNMP agents respond. TX power not yet scraped.",
  "tags": [
    "network",
    "snmp",
    "interfaces",
    "convergence",
    "from-pilot"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics-longterm"
        },
        "query": "label_values(interface_octets_in_bytes_total, device_name)",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "interface",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics-longterm"
        },
        "query": "label_values(interface_octets_in_bytes_total{device_name=~\"$device\"}, interface_name)",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Interface Status",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "targets": [
        {
          "expr": "interface_status{device_name=~\"$device\", interface_name=~\"$interface\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "device_name": "Device",
              "interface_name": "Interface",
              "Value": "Status"
            }
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Up",
                        "color": "green"
                      },
                      "2": {
                        "text": "Down",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Interface Throughput - Inbound (bits/sec)",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "targets": [
        {
          "expr": "rate(interface_octets_in_bytes_total{device_name=~\"$device\", interface_name=~\"$interface\"}[5m]) * 8",
          "legendFormat": "{{device_name}} / {{interface_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Interface Throughput - Outbound (bits/sec)",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "targets": [
        {
          "expr": "rate(interface_octets_out_bytes_total{device_name=~\"$device\", interface_name=~\"$interface\"}[5m]) * 8",
          "legendFormat": "{{device_name}} / {{interface_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Interface Errors - Inbound",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "targets": [
        {
          "expr": "rate(interface_errors_in_total{device_name=~\"$device\", interface_name=~\"$interface\"}[5m])",
          "legendFormat": "{{device_name}} / {{interface_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "err/s",
          "custom": {
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Interface Errors - Outbound",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "targets": [
        {
          "expr": "rate(interface_errors_out_total{device_name=~\"$device\", interface_name=~\"$interface\"}[5m])",
          "legendFormat": "{{device_name}} / {{interface_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "err/s",
          "custom": {
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Total Bytes Transferred (Top 10 Interfaces)",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "targets": [
        {
          "expr": "topk(10, increase(interface_octets_in_bytes_total{device_name=~\"$device\", interface_name=~\"$interface\"}[24h]) + increase(interface_octets_out_bytes_total{device_name=~\"$device\", interface_name=~\"$interface\"}[24h]))",
          "legendFormat": "{{device_name}} / {{interface_name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 7,
      "title": "Interfaces Down",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics-longterm"
      },
      "targets": [
        {
          "expr": "count(interface_status{device_name=~\"$device\", interface_name=~\"$interface\"} == 2) or vector(0)",
          "legendFormat": "Down"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        }
      }
    }
  ]
}
