    {
      "id": 201,
      "title": "Active alerts",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 60,
      "title": "Currently firing (Prometheus ALERTS)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "site": true,
              "instance": true,
              "alertstate": true,
              "prometheus": true
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "device_name": "Device",
              "investigate": "Investigate",
              "Value": "Active"
            }
          }
        }
      ]
    },
    {
      "id": 202,
      "title": "Edge & wireless access",
