    {
      "id": 83,
      "type": "timeseries",
      "title": "Firewall block rate by device",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (device_name) (rate({job=\"device-syslog\", app=~\"filterlog|snort|suricata\"} |~ \"(?i)(,block,|,reject,|blocked|denied)\" [5m]))",
          "legendFormat": "{{device_name}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 84,
      "type": "timeseries",
      "title": "DNS resolver activity (unbound)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "custom": {
