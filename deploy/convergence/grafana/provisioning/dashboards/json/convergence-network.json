      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(probe_success{job=~\"blackbox_wan_.*\"} == 1) or vector(0)",
          "legendFormat": "WAN probes up",
