    {
      "id": 94,
      "title": "Token totals by provider / model / agent",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, model, agent) (netclaw_model_input_tokens_total)",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "site": true,
              "instance": true
            },
            "renameByName": {
              "provider": "Provider",
              "model": "Model",
              "agent": "Agent",
              "Value": "Input tokens"
            }
          }
        }
      ]
    },
