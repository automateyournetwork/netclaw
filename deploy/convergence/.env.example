# NetClaw Convergence Docker stack — copy to .env and edit
#   cp deploy/convergence/.env.example deploy/convergence/.env

# --- Host ports ---
CONVERGENCE_API_HOST_PORT=3080
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
BLACKBOX_HOST_PORT=9115
UNIFI_EXPORTER_HOST_PORT=9899

# --- Postgres ---
PGDATABASE=home
PGUSER=home
PGPASSWORD=home_dev_change_me

# --- convergence-api ---
PUBLIC_URL=http://127.0.0.1:3080
JWT_SECRET=change-me-to-a-long-random-string

# API keys (JSON). Outer single-quotes required so Docker Compose keeps JSON quotes.
# HUD CONVERGENCE_API_TOKEN must match the "key" field.
# Generate: openssl rand -hex 24
API_KEYS='[{"id":"hud","name":"HUD","key":"dev-convergence-api-key-change-me","role":"admin","sites":["home"]}]'

# Optional human users (empty = API key only is fine for HUD)
USERS='[]'

# Site config consumed by convergence-api health/wifi queries
# Optional per-site "switches" block (inside each site object):
#   "switches": {
#     "match":  "sw-.*",                              PromQL regex on device_name;
#                                                     default ".*" = every device
#                                                     reporting interface_status.
#                                                     Narrow it only if that metric
#                                                     also carries non-switches.
#     "models": { "sw-01": "Cisco C9300-48P" }        display labels only; anything
#                                                     absent falls back to a metric
#                                                     label, then a generic string
#   }
# These were hardcoded to one lab's device names, which left the devices table
# empty for every other deployment. Leave "switches" out entirely and the table
# shows whatever the SNMP exporter sees.
SITES_CONFIG='{"home":{"name":"Home","wanInterface":"wan","deviceName":"edge","speedtestTarget":1000000000,"thresholds":{"latency":{"green":40,"yellow":80},"loss":{"green":0,"yellow":5},"txRetries":{"green":20,"yellow":35},"speedtest":{"green":900000000,"yellow":700000000}}}}'

# --- Alertmanager → host alert-receiver (T031) ---
# Linux Docker: host.docker.internal works via compose extra_hosts host-gateway
# Or use the host LAN IP: http://192.168.x.x:8099/webhook
ALERT_RECEIVER_URL=http://host.docker.internal:8099/webhook

# --- UniFi adapter (compose --profile unifi) ---
# Copy from ~/.openclaw/.env (UNIFI_HOST / UNIFI_API_KEY) for local testing.
# Example pilot: https://192.168.100.10:11443
UNIFI_HOST=https://192.168.100.10:11443
UNIFI_API_KEY=
SITE_LABEL=home
GUEST_ACCESS_TYPES=GUEST,HOTSPOT

# --- Generic SNMP wireless adapter (compose --profile generic-snmp-wireless, T071) ---
# Second wireless vendor path (Omada / Aruba Instant On / MikroTik / any SNMP AP).
# NOTE: the scrape target IP is set directly in prometheus/prometheus.yml
# (job generic_snmp_wireless) — env substitution is not applied to that file.
SNMP_WIRELESS_EXPORTER_HOST_PORT=9116

# --- Campus/wired device SNMP (compose --profile device-snmp, Phase 8) ---
# Cisco Catalyst / access switches — NOT the wireless job above.
# Targets + device_name labels: prometheus/prometheus.yml job device_snmp
# (or scripts/render-device-snmp-scrape.py from config/convergence.yaml).
SNMP_DEVICE_EXPORTER_HOST_PORT=9117

# Edge firewall blackbox target is set in prometheus/prometheus.yml
# (default: https://192.168.13.1:440 pfSense). Edit that file to change.
#
# Management GUI links (HOME Devices / Wi‑Fi name clicks open these in a new tab)
PFSENSE_MGMT_URL=https://192.168.13.1:440
EDGE_MGMT_URL=https://192.168.13.1:440
UNIFI_MGMT_URL=https://192.168.100.10:11443



# --- HUD (set in ~/.openclaw/.env, not required inside compose) ---
# CONVERGENCE_API_URL=http://127.0.0.1:3080
# CONVERGENCE_API_TOKEN=dev-convergence-api-key-change-me

# --- SoT adapter (T070) ---
# Source of Truth for device inventory enrichment in convergence-api.
SOT_TYPE=none
# Nautobot (set when SOT_TYPE=nautobot):
# NAUTOBOT_URL=https://nautobot.internal.byrnbaker.me
# NAUTOBOT_TOKEN=
# NetBox (stub, set when SOT_TYPE=netbox):
# NETBOX_URL=
# NETBOX_TOKEN=

# --- Full stack overlay (docker-compose.full.yml, T072) ---
# Loki, VictoriaMetrics, Grafana, speedtest. Add -f docker-compose.full.yml
# and --profile full (or --profile speedtest for just the speedtest path).
LOKI_HOST_PORT=3100
VICTORIAMETRICS_HOST_PORT=8428
GRAFANA_HOST_PORT=3300
GRAFANA_ROOT_URL=http://localhost:3300
PUSHGATEWAY_HOST_PORT=9091
SPEEDTEST_INTERVAL_SECONDS=3600
SPEEDTEST_SERVER_ID=

# --- SuzieQ state-history plane (Phase 12, profile: suzieq) ---
# Optional scale tier. docker compose --profile suzieq up -d
# Requires a read-only SSH service account on managed devices.
# See: deploy/convergence/adapters/suzieq/README.md
SUZIEQ_DEVICE_USER=suzieq-readonly
SUZIEQ_DEVICE_PASSWORD=
SUZIEQ_API_KEY=change-me-to-a-random-string
SUZIEQ_REST_PORT=8000
